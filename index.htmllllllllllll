// ── State ────────────────────────────────────────────────────────────────────
let sections = [];
let seeded = false;

function sortSections(arr) {
  return arr.sort((a, b) => {
    const ai = DEFAULT_SECTIONS.findIndex(d => d.id === a.id);
    const bi = DEFAULT_SECTIONS.findIndex(d => d.id === b.id);
    return (ai === -1 ? 999 : ai) - (bi === -1 ? 999 : bi);
  });
}

function parseSections(data) {
  return sortSections(Object.values(data).map(s => ({
    ...s,
    peptides: s.peptides ? Object.values(s.peptides) : []
  })));
}

function seedDatabase() {
  const seedData = {};
  DEFAULT_SECTIONS.forEach(s => {
    const peptideMap = {};
    s.peptides.forEach(p => { peptideMap[p.id] = p; });
    seedData[s.id] = { id: s.id, title: s.title, peptides: peptideMap };
  });
  return db.ref('sections').set(seedData);
}

// ── Single real-time listener ─────────────────────────────────────────────────
db.ref('sections').on('value', snapshot => {
  if (!snapshot.exists()) {
    // Database empty — seed it
    if (!seeded) {
      seeded = true;
      sections = JSON.parse(JSON.stringify(DEFAULT_SECTIONS));
      render();
      seedDatabase().catch(e => console.error('Seed error:', e));
    }
    return;
  }
  sections = parseSections(snapshot.val());
  render();
}, error => {
  console.error('Firebase error:', error);
  // Fallback to default data if Firebase fails
  sections = JSON.parse(JSON.stringify(DEFAULT_SECTIONS));
  render();
});

// ── Render ───────────────────────────────────────────────────────────────────
function jumpTo(id) {
  const el = document.getElementById(id);
  if (!el) return;
  const hdr = document.getElementById('hdr');
  const offset = (hdr ? hdr.offsetHeight : 90) + 20;
  window.scrollTo({ top: el.getBoundingClientRect().top + window.pageYOffset - offset, behavior: 'smooth' });
}

function render() {
  renderNav();
  renderAdminBar();
  renderContent();
  document.body.classList.toggle('admin-mode', isAdmin);
  const q = document.getElementById('search-input')?.value || '';
  if (q) handleSearch(q);
}

function renderNav() {
  document.getElementById('nav-bar').innerHTML = sections.map(s =>
    `<button class="nav-btn" onclick="jumpTo('sec-${s.id}')">${s.title}</button>`
  ).join('');
}

function renderAdminBar() {
  document.getElementById('admin-bar').innerHTML = isAdmin
    ? `<div class="admin-badge">ADMIN ON</div>
       <button class="btn-add" onclick="openAddModal()">+ ADD PEPTIDE</button>
       <button class="btn-signout" onclick="signOut()">SIGN OUT</button>`
    : `<button class="btn-admin" onclick="openPassModal()">ADMIN</button>`;
}

function renderContent() {
  document.getElementById('content').innerHTML =
    sections.map(s => `
      <div class="section" id="sec-${s.id}">
        <div class="section-hdr">
          <div class="section-bar"></div>
          <div style="flex:1">
            <div class="section-title">${s.title}</div>
            <div class="section-line"></div>
          </div>
        </div>
        <div class="cards-grid">
          ${s.peptides.map(p => `
            <div class="card">
              <button class="delete-btn" onclick="deleteCard('${s.id}','${p.id}')">✕ DELETE</button>
              <div class="card-name">${p.name}</div>
              <div class="card-desc">${p.desc}</div>
              <div class="card-divider">
                <div class="card-label">RECONSTITUTION</div>
                <div class="card-recon">${p.recon}</div>
              </div>
              <div class="card-dose-wrap">
                <div class="card-label">DOSING</div>
                <div class="card-dose">${p.dose}</div>
              </div>
            </div>`).join('')}
        </div>
      </div>`).join('') +
    `<div class="footer">FOR RESEARCH PURPOSES ONLY · NOT FOR HUMAN CONSUMPTION · DM FOR AVAILABILITY</div>`;
}

// ── Search ───────────────────────────────────────────────────────────────────
function handleSearch(query) {
  const q = query.trim().toLowerCase();
  const allSections = document.querySelectorAll('.section');
  let total = 0;
  allSections.forEach(sec => {
    const cards = sec.querySelectorAll('.card');
    let vis = 0;
    cards.forEach(card => {
      const match = !q || card.innerText.toLowerCase().includes(q);
      card.style.display = match ? '' : 'none';
      if (match) vis++;
    });
    sec.style.display = vis === 0 && q ? 'none' : '';
    total += vis;
  });
  let noRes = document.getElementById('no-results');
  if (!noRes) {
    noRes = document.createElement('div');
    noRes.id = 'no-results';
    noRes.style.cssText = 'text-align:center;color:#555;font-size:14px;padding:60px 20px;letter-spacing:1px;';
    noRes.textContent = 'No peptides found.';
    document.getElementById('content').appendChild(noRes);
  }
  noRes.style.display = (total === 0 && q) ? 'block' : 'none';
}

// ── Password ─────────────────────────────────────────────────────────────────
function openPassModal() {
  document.getElementById('pass-input').value = '';
  document.getElementById('pass-error').style.display = 'none';
  document.getElementById('pass-input').classList.remove('pass-input-error');
  document.getElementById('pass-modal').style.display = 'flex';
  setTimeout(() => document.getElementById('pass-input').focus(), 100);
}
function closePassModal() { document.getElementById('pass-modal').style.display = 'none'; }
function clearPassError() {
  document.getElementById('pass-error').style.display = 'none';
  document.getElementById('pass-input').classList.remove('pass-input-error');
}
function submitPass() {
  if (document.getElementById('pass-input').value === PASS) {
    isAdmin = true; closePassModal(); render();
  } else {
    document.getElementById('pass-error').style.display = 'block';
    document.getElementById('pass-input').classList.add('pass-input-error');
  }
}
function signOut() { isAdmin = false; render(); }

// ── Add peptide ───────────────────────────────────────────────────────────────
function openAddModal() {
  document.getElementById('af-sec').innerHTML = sections.map(s =>
    `<option value="${s.id}">${s.title}</option>`).join('');
  ['af-name','af-desc','af-recon','af-dose'].forEach(id => document.getElementById(id).value = '');
  document.getElementById('add-modal').style.display = 'flex';
  setTimeout(() => document.getElementById('af-name').focus(), 100);
}
function closeAddModal() { document.getElementById('add-modal').style.display = 'none'; }
function submitAdd() {
  const sid   = document.getElementById('af-sec').value;
  const name  = document.getElementById('af-name').value.trim();
  const desc  = document.getElementById('af-desc').value.trim();
  const recon = document.getElementById('af-recon').value.trim();
  const dose  = document.getElementById('af-dose').value.trim();
  if (!name) { alert('Please enter a peptide name.'); return; }
  const newId = 'p-' + Date.now();
  // Write directly to Firebase
  db.ref(`sections/${sid}/peptides/${newId}`).set({ id: newId, name, desc, recon, dose })
    .then(() => { closeAddModal(); })
    .catch(err => alert('Error saving: ' + err.message));
}

// ── Delete peptide ────────────────────────────────────────────────────────────
function deleteCard(sid, pid) {
  if (!confirm('Delete this peptide?')) return;
  db.ref(`sections/${sid}/peptides/${pid}`).remove()
    .catch(err => alert('Error deleting: ' + err.message));
}
</script>
